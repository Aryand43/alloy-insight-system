{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "demo-data/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ]
}
